# -*- coding: utf-8 -*-
# settings for running as a container - everything deployment-specific comes from the
# environment so one image serves any install; symlinked to ureport/settings.py at build

import os

import dj_database_url

from django.core.exceptions import ImproperlyConfigured

from ureport.settings_common import *  # noqa


def env_bool(name, default):
    return os.environ.get(name, "on" if default else "off").lower() in ("1", "true", "yes", "on")


IS_PROD = env_bool("IS_PROD", False)

DEBUG = env_bool("DJANGO_DEBUG", False)
THUMBNAIL_DEBUG = DEBUG
COMPRESS_ENABLED = True

# fail on boot rather than fall back to the publicly-known development key
SECRET_KEY = os.environ["DJANGO_SECRET_KEY"]

# note HOSTNAME the setting can't come from HOSTNAME the env var - containers set that
# to the container id
HOSTNAME = os.environ.get("SITE_HOSTNAME", "localhost:8000")
EMPTY_SUBDOMAIN_HOST = os.environ.get("EMPTY_SUBDOMAIN_HOST", "http://" + HOSTNAME)
SITE_API_HOST = os.environ.get("SITE_API_HOST", "https://api.rapidpro.io")
ALLOWED_HOSTS = os.environ.get("ALLOWED_HOSTS", "*").split(",")

SESSION_EXPIRE_AT_BROWSER_CLOSE = False
SESSION_COOKIE_AGE = 1209600  # 2 weeks

# each org site is served from a subdomain of SITE_HOSTNAME; set this to ".<SITE_HOSTNAME>" so that a login on one
# host (e.g. the root host where SSO callbacks land) is valid on all of them
if os.environ.get("SESSION_COOKIE_DOMAIN"):
    SESSION_COOKIE_DOMAIN = os.environ["SESSION_COOKIE_DOMAIN"]
    CSRF_COOKIE_DOMAIN = os.environ["SESSION_COOKIE_DOMAIN"]
SESSION_ENGINE = "django.contrib.sessions.backends.cached_db"
SESSION_CACHE_ALIAS = "default"
MESSAGE_STORAGE = "django.contrib.messages.storage.session.SessionStorage"
CSRF_COOKIE_SAMESITE = "Strict"
CSRF_COOKIE_AGE = 10800

# on by default for TLS-terminating deployments; turn off to log in over plain http. Since the
# Secure cookies make plain http unusable anyway, every request is treated as https rather than
# trusting a forwarded header from whatever terminates TLS.
if env_bool("DJANGO_SECURE", True):
    SESSION_COOKIE_SECURE = True
    CSRF_COOKIE_SECURE = True
    SECURE_ASSUME_HTTPS = True
    SECURE_HSTS_INCLUDE_SUBDOMAINS = True
    SECURE_HSTS_PRELOAD = False
    SECURE_HSTS_SECONDS = 86400

# single sign-on: a Google client and/or one generic OpenID Connect provider (e.g. an Entra ID tenant), each enabled by
# setting its client id. Providers send users back to the callback URL on SITE_HOSTNAME, so register
# https://<SITE_HOSTNAME>/accounts/google/login/callback/ with Google and
# https://<SITE_HOSTNAME>/accounts/oidc/<SSO_OIDC_PROVIDER_ID>/login/callback/ with the OpenID Connect provider.
SOCIALACCOUNT_PROVIDERS = {}


def env_required(name):
    if not os.environ.get(name):
        raise ImproperlyConfigured(f"{name} must be set when single sign-on is configured")
    return os.environ[name]


def env_list(name):
    return [v.strip() for v in os.environ.get(name, "").split(",") if v.strip()]


if os.environ.get("SSO_GOOGLE_CLIENT_ID"):
    SOCIALACCOUNT_PROVIDERS["google"] = {
        "SCOPE": ["profile", "email"],
        "AUTH_PARAMS": {"access_type": "online"},
        "OAUTH_PKCE_ENABLED": True,
        "APP": {"client_id": os.environ["SSO_GOOGLE_CLIENT_ID"], "secret": env_required("SSO_GOOGLE_SECRET")},
    }

if os.environ.get("SSO_OIDC_CLIENT_ID"):
    # SSO_OIDC_SERVER_URL is the issuer, i.e. where /.well-known/openid-configuration is served from. Providers that
    # don't mark emails as verified can be trusted for specific domains with SSO_OIDC_VERIFIED_EMAIL_DOMAINS, and
    # ones that identify users by another claim (e.g. Entra ID's preferred_username) with SSO_OIDC_IDENTITY_CLAIM
    # plus the domains that claim may vouch for in SSO_OIDC_IDENTITY_CLAIM_DOMAINS.
    SOCIALACCOUNT_PROVIDERS["openid_connect"] = {
        "OAUTH_PKCE_ENABLED": True,
        "APPS": [
            {
                "provider_id": os.environ.get("SSO_OIDC_PROVIDER_ID", "oidc"),
                "name": os.environ.get("SSO_OIDC_NAME", "Single Sign-On"),
                "client_id": os.environ["SSO_OIDC_CLIENT_ID"],
                "secret": env_required("SSO_OIDC_SECRET"),
                "settings": {
                    "server_url": env_required("SSO_OIDC_SERVER_URL"),
                    "token_auth_method": "client_secret_basic",
                    "verified_email": env_list("SSO_OIDC_VERIFIED_EMAIL_DOMAINS"),
                    "identity_claim": os.environ.get("SSO_OIDC_IDENTITY_CLAIM"),
                    "identity_claim_domains": env_list("SSO_OIDC_IDENTITY_CLAIM_DOMAINS"),
                },
            }
        ],
    }

# a login completed on the root host is only any use if the session is valid on the org subdomains too
if SOCIALACCOUNT_PROVIDERS and not os.environ.get("SESSION_COOKIE_DOMAIN"):
    SESSION_COOKIE_DOMAIN = CSRF_COOKIE_DOMAIN = "." + HOSTNAME.partition(":")[0]

if os.environ.get("ADMIN_EMAIL"):
    ADMINS = (("Ops", os.environ["ADMIN_EMAIL"]),)
    MANAGERS = ADMINS

MAILERS = {
    "default": {
        "BACKEND": "django.core.mail.backends.smtp.EmailBackend",
        "OPTIONS": {
            "host": os.environ.get("EMAIL_HOST", "smtp.gmail.com"),
            "port": int(os.environ.get("EMAIL_PORT", "587")),
            "username": os.environ.get("EMAIL_HOST_USER", ""),
            "password": os.environ.get("EMAIL_HOST_PASSWORD", ""),
            "use_tls": env_bool("EMAIL_USE_TLS", True),
        },
    }
}
DEFAULT_FROM_EMAIL = os.environ.get("DEFAULT_FROM_EMAIL", os.environ.get("EMAIL_HOST_USER", ""))

# DATABASE_URL is required at runtime; at image build (collectstatic/compress) it is
# absent and the sqlite default from settings_common stands in - no queries are run
_database = dj_database_url.config(conn_max_age=60)
if _database:
    DATABASES["default"] = _database  # noqa

CELERY_BROKER_URL = os.environ.get("VALKEY_URL") or "redis://%s:%s/%s" % (
    os.environ.get("VALKEY_HOST", "valkey"),
    os.environ.get("VALKEY_PORT", "6379"),
    os.environ.get("VALKEY_DB", "1"),
)
CELERY_RESULT_BACKEND = CELERY_BROKER_URL

CACHES = {
    "default": {
        "BACKEND": "django_valkey.cache.ValkeyCache",
        "LOCATION": CELERY_BROKER_URL,
    }
}

# media is on the filesystem (mount a volume) unless a bucket is configured
if os.environ.get("AWS_STORAGE_BUCKET_NAME"):
    AWS_STORAGE_BUCKET_NAME = os.environ["AWS_STORAGE_BUCKET_NAME"]
    AWS_ACCESS_KEY_ID = os.environ.get("AWS_ACCESS_KEY_ID")
    AWS_SECRET_ACCESS_KEY = os.environ.get("AWS_SECRET_ACCESS_KEY")
    AWS_S3_SECURE_URLS = True
    AWS_QUERYSTRING_AUTH = False
    AWS_S3_OBJECT_PARAMETERS = {"CacheControl": "max-age=86400"}
    STORAGES["default"] = {"BACKEND": "storages.backends.s3boto3.S3Boto3Storage"}  # noqa
    THUMBNAIL_STORAGE = STORAGES["default"]["BACKEND"]  # noqa
    MEDIA_URL = os.environ.get("MEDIA_URL", "https://%s.s3.amazonaws.com/" % AWS_STORAGE_BUCKET_NAME)

# everything to stdout for the container runtime to collect
LOGGING = {
    "version": 1,
    # keep loggers created before this is applied, i.e. gunicorn's access and error loggers
    "disable_existing_loggers": False,
    "formatters": {
        "verbose": {"format": "%(levelname)s %(asctime)s %(module)s %(process)d %(thread)d %(message)s"},
    },
    "handlers": {
        "console": {"level": "DEBUG", "class": "logging.StreamHandler", "formatter": "verbose"},
        "null": {"level": "DEBUG", "class": "logging.NullHandler"},
    },
    "root": {"level": "INFO", "handlers": ["console"]},
    "loggers": {
        "django.db.backends": {"level": "ERROR", "handlers": ["console"], "propagate": False},
        "django.security.DisallowedHost": {"handlers": ["null"], "propagate": False},
    },
}

# static assets are collected and compressed into the image at build time
COMPRESS_CSS_HASHING_METHOD = "content"
COMPRESS_OFFLINE = True
WHITENOISE_MAX_AGE = 3600
COMPRESS_OFFLINE_CONTEXT = [
    dict(STATIC_URL=STATIC_URL, base_template="frame.html", org=None, debug=False, testing=False),  # noqa
    dict(STATIC_URL=STATIC_URL, base_template="public_base.html", org=None, debug=False, testing=False),  # noqa
]
